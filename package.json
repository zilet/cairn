{
  "name": "cairn",
  "version": "0.8.1",
  "type": "module",
  "license": "MIT",
  "description": "Cairn — self-hosted, connected, day-reading wellness OS for training (lifting, running & hybrid), nutrition & longevity with an agentic coaching loop.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zilet/cairn.git"
  },
  "bugs": {
    "url": "https://github.com/zilet/cairn/issues"
  },
  "homepage": "https://github.com/zilet/cairn#readme",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run client:check && npm run client:build && tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "seed:demo": "tsx src/demoSeed.ts",
    "seed:art:build": "mkdir -p data/seed-art-build && DATA_DIR=data/seed-art-build DB_PATH=data/seed-art-build/cairn.db tsx src/buildSeedArt.ts",
    "garmin:sync": "tsx src/garmin.ts",
    "reset": "rm -f data/cairn.db data/cairn.db-* && npm run seed",
    "migrate": "tsx src/migrate.ts",
    "backup": "curl -fsS http://localhost:8787/api/export -o cairn-export.json && echo saved cairn-export.json",
    "docs:index": "node scripts/gen-docs.mjs",
    "docs:check": "node scripts/gen-docs.mjs --check",
    "actions:check": "node scripts/check-action-pins.mjs",
    "client:check": "tsc -p tsconfig.client.build.json --noEmit",
    "client:build": "node scripts/build-client.mjs",
    "client:verify": "npm run typecheck:client && node scripts/check-client-build-output.mjs",
    "typecheck:client": "tsc -p tsconfig.client.json && npm run client:check",
    "public:check": "node scripts/check-public-scripts.mjs",
    "lint": "biome lint .",
    "lint:changed": "biome lint --changed",
    "format": "biome format --write .",
    "format:changed": "biome format --write --changed",
    "pretest": "npm run build",
    "test": "node test/run.mjs",
    "test:built": "node test/run.mjs",
    "test:serial": "node test/run.mjs --workers=1 --reporter=spec",
    "presmoke": "npm run build",
    "smoke": "node test/smoke.mjs",
    "smoke:built": "node test/smoke.mjs",
    "presmoke:browser": "npm run build",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "smoke:browser:built": "node scripts/smoke-browser.mjs",
    "launch:check": "node scripts/check-launch-safety.mjs",
    "verify": "node scripts/run-verify.mjs",
    "verify:full": "npm run verify && npm run smoke:built",
    "release:check": "npm run verify && npm run smoke:built && npm run smoke:browser:built"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "garmin-connect": "^1.6.2",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
