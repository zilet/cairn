{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildcache/server.tsbuildinfo",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/client/**/*.ts",
    // The client ambient-global declarations must never reach server compilation:
    // with them included, a server module can reference a browser-only global and
    // still typecheck, deferring the failure to a runtime ReferenceError.
    "src/contracts/client-globals.d.ts",
    "src/contracts/client-shell-globals.d.ts"
  ]
}
