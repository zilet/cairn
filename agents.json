{
  "claude": {
    "command": "claude",
    "args": ["{file_access_args}", "{mcp_config_args}", "{model_args}", "{reasoning_args}", "-p", "{prompt}"],
    "input": "arg",
    "description": "Claude Code (Anthropic Pro/Max). Auth: ~/.claude.",
    "env_required": [],
    "web_access": true,
    "research_note": "Headless `claude -p` has WebSearch/WebFetch available, so it can do live evidence research for the grounding layer (settings.research_enabled). Extra fields here are informational only — runAgent reads just command/args/input/env_required.",
    "login": ["auth", "login"],
    "status_check": ["auth", "status"],
    "auth_state": [".claude.json", ".claude"],
    "models_list": null,
    "model_flag": ["--model", "{model}"],
    "capabilities": { "model": true, "reasoning": ["low", "medium", "high", "xhigh"] },
    "reasoning_flag": ["--effort", "{reasoning}"],
    "file_access_args": ["--add-dir", "{data_dir}"],
    "install": {
      "method": "npm",
      "package": "@anthropic-ai/claude-code",
      "version": "2.1.207"
    },
    "stream": {
      "format": "claude",
      "args": ["{file_access_args}", "{mcp_config_args}", "{model_args}", "{reasoning_args}", "-p", "{prompt}", "--output-format", "stream-json", "--include-partial-messages", "--verbose"]
    }
  },
  "codex": {
    "command": "codex",
    "args": ["exec", "{model_args}", "{reasoning_args}", "--sandbox", "read-only", "--skip-git-repo-check", "{file_access_args}", "{prompt}", "{image_args}"],
    "input": "arg",
    "description": "OpenAI Codex (Sign in with ChatGPT). Auth: ~/.codex.",
    "env_required": [],
    "login": ["login", "--device-auth"],
    "status_check": ["login", "status"],
    "auth_state": [".codex/auth.json"],
    "models_list": null,
    "model_flag": ["--model", "{model}"],
    "capabilities": { "model": true, "reasoning": ["low", "medium", "high", "xhigh"] },
    "reasoning_flag": ["-c", "model_reasoning_effort={reasoning}"],
    "file_access_args": ["--cd", "{data_dir}", "--add-dir", "{data_dir}"],
    "image_args": ["--image", "{image}"],
    "install": {
      "method": "npm",
      "package": "@openai/codex",
      "version": "0.144.1",
      "args": ["--include=optional"]
    }
  },
  "antigravity": {
    "command": "agy",
    "args": ["{file_access_args}", "{model_args}", "{reasoning_args}", "-p", "{prompt}", "--print-timeout", "5m"],
    "input": "arg",
    "description": "Google Antigravity CLI 'agy' (the successor to the Gemini CLI; Google account). Auth: ~/.gemini.",
    "env_required": [],
    "login": [],
    "status_check": ["models"],
    "auth_state": [".gemini"],
    "models_list": ["models"],
    "model_flag": ["--model", "{model}"],
    "capabilities": { "model": true, "reasoning": ["low", "medium", "high"] },
    "reasoning_flag": ["--effort", "{reasoning}"],
    "file_access_args": ["--add-dir", "{data_dir}"],
    "install": {
      "method": "script",
      "url": "https://antigravity.google/cli/install.sh",
      "sha256": "ee1ea43ce4e9e56356c4ab6dad907ef357ae4bdfcaadb682735909fb57c9c640",
      "update_args": ["update"]
    }
  },
  "grok": {
    "command": "grok",
    "args": ["{file_access_args}", "{model_args}", "{reasoning_args}", "-p", "{prompt}"],
    "input": "arg",
    "description": "xAI Grok Build (SuperGrok/X Premium+). Headless may need XAI_API_KEY.",
    "env_required": [],
    "login": ["login", "--device-auth"],
    "status_check": null,
    "auth_state": [".grok/auth.json"],
    "models_list": ["models"],
    "model_flag": ["--model", "{model}"],
    "capabilities": { "model": true, "reasoning": ["low", "medium", "high"] },
    "reasoning_flag": ["--reasoning-effort", "{reasoning}"],
    "file_access_args": ["--cwd", "{data_dir}"],
    "install": {
      "method": "script",
      "url": "https://x.ai/cli/install.sh",
      "sha256": "2019f38002a2beab27f65b928db5d33d2bbe8c2828e4e41081ac23ec33b7a658",
      "update_args": ["update"]
    },
    "stream": {
      "format": "grok",
      "args": ["{file_access_args}", "{model_args}", "{reasoning_args}", "-p", "{prompt}", "--output-format", "streaming-json"]
    }
  },
  "stub": {
    "command": "sh",
    "args": ["-c", "printf '%s' '{\"summary\":\"Stub test proposal (no API used).\",\"changes\":[{\"day_number\":1,\"exercise\":\"Back Squat\",\"target_weight\":195,\"reason\":\"pipeline smoke test\"}],\"notes\":\"Built-in offline stub. Use claude/codex/antigravity/grok for real coaching.\"}'"],
    "input": "arg",
    "description": "Offline stub for testing the propose/apply loop with no API key.",
    "env_required": [],
    "login": null,
    "status_check": null,
    "auth_state": null,
    "models_list": null,
    "model_flag": ["--model", "{model}"],
    "capabilities": { "model": false, "reasoning": [], "execution_profile_noop": true },
    "reasoning_flag": null
  }
}
