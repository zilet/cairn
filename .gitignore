# dependencies & build output
node_modules/
dist/
.tsbuildcache/

# generated browser client output; source lives in src/client/
public/js/*.js
!public/js/10-boot.js

# runtime SQLite database (created on first boot)
/data/
*.db
*.db-wal
*.db-shm

# distribution bundle / archives
files.zip
*.zip

# local secrets (copy of .env.example with real keys)
.env

# personal, local-only Claude Code project notes (override of CLAUDE.md) — kept on
# disk, never published.
CLAUDE.local.md

# machine-specific agent tooling (local dev-server launch config; the shared
# .claude/skills/ stays committed)
.claude/launch.json
.claude/worktrees/

# personal, local-only files — kept on disk, never published. One folder holds
# everything you use privately, mirroring the repo layout:
#   .local/scripts/   deploy-rpi.sh, rpi-bootstrap.sh, rpi-https.sh, rpi-backup.sh
#   .local/docs/      RPI.md (and any other private notes)
#   .local/examples/  design-reference material (videos, mocks)
.local/

# marketing capture sources (full-page screenshots + scroll mp4s) — regenerable
# via `npm run seed:demo` + the capture flow in `.local/docs/MARKETING.md`. The
# committed README assets (media/*.gif, media/cairn-hero.mp4, media/screens/*.png) stay.
media/frames/

# logs & OS cruft
*.log
tmp-*.json
.DS_Store
build-assets/

# Generated from src/client/cairn-body-figure.ts (npm run client:build)
public/cairn-body-figure.js
