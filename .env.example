# Cairn — environment variables
# Copy to .env and edit. None of these are required for local dev;
# the defaults listed here match docker-compose.yml.

# ---------- server ----------
PORT=8787
HOST=0.0.0.0

# Docker Compose host-side identity. Leave these at their defaults for one
# instance. A household member uses a unique container name + host port and a
# separate Compose project; see docs/HOUSEHOLDS.md. These do not change Cairn's
# internal listener, which remains 8787 inside the container.
# CAIRN_CONTAINER_NAME=cairn
# CAIRN_BIND_HOST=127.0.0.1
# CAIRN_HOST_PORT=8787

# ---------- logging ----------
# Minimum level written to stdout/stderr: debug | info | warn | error. `debug` adds
# the scheduler's per-tick chatter; `warn` quiets everything but problems.
# CAIRN_LOG_LEVEL=info
# Emit each line as one JSON object instead of plain text, for a log shipper.
# CAIRN_LOG_JSON=0

# ---------- auth (optional, but mandatory once exposed) ----------
# Cairn has NO auth by default (single-user, meant for a trusted private network).
# Set a token to require it on /api and /mcp — MANDATORY if the port is reachable
# beyond localhost (LAN, Tailscale Funnel, a public reverse proxy, a "public" cloud
# sandbox port). A browser signs in once (passkey, a one-time pairing code from
# Settings → Devices, or this token as the recovery key) and keeps its own device
# session; API clients send `Authorization: Bearer <token>`. AI apps connect to /mcp
# with their own key or OAuth (Settings → Devices → Connected AI apps), never this token.
# The one-line installer and the Railway template generate it for you.
# Generate one: `openssl rand -hex 32`
# CAIRN_AUTH_TOKEN=
#
# Fail closed: with this set to 1, Cairn REFUSES to start unless CAIRN_AUTH_TOKEN
# is also set. Bake it into any compose/template that exposes the port so the
# instance can never boot unauthenticated. Leave unset for localhost/tailnet use.
# CAIRN_REQUIRE_AUTH=0
#
# Per-IP rate limit on /api and /mcp (defense-in-depth; active only when a token
# is set). Defaults shown; set CAIRN_RATE_LIMIT=0 to disable even with auth on.
# CAIRN_RATE_LIMIT=600
# CAIRN_RATE_WINDOW_MS=60000
#
# Behind a reverse proxy (Caddy, nginx, Cloudflare Tunnel, a PaaS), the number of
# proxy hops whose X-Forwarded-* headers to trust, so sign-in cookies, passkeys and
# rate limiting see the real host and client. On Railway, Cairn uses 1 on its own.
# CAIRN_TRUST_PROXY=1
#
# Until anyone has signed in, a fresh token-gated install mints a one-hour first-sign-in
# code and logs one line with it (so a host with no terminal, like Railway, can sign in
# from its log viewer). On by default there; set 0 to never mint or print it and sign in
# with the access token instead.
# CAIRN_FIRST_SIGNIN_LOG=0
#
# Where Cairn thinks it runs: railway | installer | docker. Normally auto-detected; the
# installer and the Railway template set it. It decides which first-visit note and
# host hints Cairn shows.
# CAIRN_PLATFORM=docker

# ---------- Apple Health Shortcut (optional) ----------
# Publish a Shortcut exported and validated by Apple's Shortcuts app, then set
# its official iCloud share URL (or a same-origin signed .shortcut asset). Cairn
# deliberately has no fabricated/default artifact. The name must exactly match
# the installed Shortcut so Connect & test can run it with pairing input.
# CAIRN_APPLE_HEALTH_SHORTCUT_URL=
# CAIRN_APPLE_HEALTH_SHORTCUT_NAME=Cairn Apple Health Sync

# ---------- storage ----------
# In Docker the /data volume is used automatically (set by the Dockerfile).
# For local dev the default is ./data/cairn.db — no override needed.
# DATA_DIR=/data          # directory that holds cairn.db (Docker default)
# DB_PATH=/data/cairn.db  # explicit full path override (rarely needed)
#
# Start empty, into the welcome (connect an AI subscription, the coach plans week
# one), seeding only the neutral exercise catalog — no example athlete, plan,
# measurements or history. Without it an empty database is seeded with a fictional
# example athlete. Read only on the first boot of an empty database. The installer
# and the Railway template set it.
# CAIRN_BLANK_PROFILE=1
#
# One-volume hosts (Railway): keep CLI sign-ins and installed AI tools under
# /data/home beside the database instead of a second volume.
# CAIRN_SINGLE_VOLUME=1
#
# Optional at-rest hardening for secrets saved through Settings (Garmin password
# and generated-art Gemini key). Env vars are still the lowest-exposure path; if
# you do use Settings for those secrets, set this once and keep it stable. Losing
# it means encrypted Settings secrets must be re-entered, though env vars still
# work. Generate one with: `openssl rand -hex 32`
# CAIRN_SETTINGS_SECRET_KEY=

# ---------- locale ----------
TZ=America/New_York       # IANA timezone — used by the scheduler for coach_hour

# ---------- weekly auto-draft (optional) ----------
# Seed values for the first-run settings row. After first boot these are
# stored in the DB and editable via the Settings tab / set_settings MCP tool.
# COACH_AGENT=           # e.g. claude, codex, auto — leave empty to skip seeding
# COACH_DAY=0            # 0=Sunday … 6=Saturday
# COACH_HOUR=20          # local hour (0-23) in TZ above

# ---------- coaching agents ----------
# How many AI CLI processes may run at once (default 2). Each takes ~200–400 MB;
# set 1 on a 1 GB host. Which model each CLI uses is chosen in Settings → Agents
# (CLI default unless you pick one).
# CAIRN_MAX_AGENT_PROCS=2

# ---------- coaching API keys ----------
# IMPORTANT: claude/codex/antigravity do NOT use an env API key for coaching.
# `claude -p` and `codex exec` authenticate through their CLI's subscription
# OAuth login dir (~/.claude, ~/.codex, ~/.gemini), stored in the cairn-home
# volume — log in once per provider (see README "Coaching agents").
# Only GROK HEADLESS reliably uses an API key:
# XAI_API_KEY=
# These two are passed through for completeness but are not the claude/codex
# coaching path; leave them empty unless you have a specific use for them.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---------- generated artwork (optional) ----------
# ARTWORK ONLY — this is NOT a coaching agent. A built-in starter pack of exercise
# and movement figures installs on first boot with no key and no cost. A Google AI
# Studio key adds generated food / exercise imagery for anything the pack misses
# (Nano Banana 2.1 by default, src/art.ts). Cairn deliberately strips it from the
# coaching agent subprocess env. Images are generated in the background and cached
# in data/art/.
# GEMINI_API_KEY=

# ---------- Garmin sync (optional, experimental) ----------
# Pull Garmin Connect activities + daily recovery metrics into source tables.
# Credentials can also be set in the Settings tab instead of here. See docs/GARMIN.md.
# GARMIN_USERNAME=
# GARMIN_PASSWORD=
# GARMIN_TOKEN_DIR=          # where OAuth tokens are cached (defaults under DATA_DIR)
# GARMIN_SYNC_DAYS=14        # how many days back to sync
# GARMIN_SYNC_LIMIT=50       # max activities per sync
# GARMIN_HR_ZONE_LIMIT=20    # max per-activity HR-zone detail calls per sync
# GARMIN_STRENGTH_LIMIT=20   # max strength activities to fetch detected sets for
# GARMIN_SOURCE_LABEL=garmin

# ---------- feedback and updates ----------
# Settings → Send feedback (only when you press Send) and the opt-in weekly usage
# ping go to the project's feedback service. This is also the built-in default.
# Point it at your own deployment (services/feedback), or set it to `off` (or empty)
# to turn the service off: feedback then opens a prefilled
# GitHub issue in your browser and the usage ping never sends.
# Everything that leaves an install: docs/HOSTING.md "What leaves your install".
CAIRN_FEEDBACK_URL=https://feedback.cairn.fit
#
# Set to 0 to stop the background download of the free exercise how-to library.
# CAIRN_GUIDE_AUTO_IMPORT=1
#
# How "Update now" in Settings works. The installer sets trigger-file (its host
# updater pulls and rolls back on failure); a host with a redeploy webhook can set
# CAIRN_DEPLOY_HOOK_URL (https only). Railway updates the image itself: leave both unset.
# CAIRN_UPDATE_METHOD=trigger-file
# CAIRN_DEPLOY_HOOK_URL=
# Before migrating, Cairn snapshots the database (data/backups, keeps 3). Set 1 to
# refuse to migrate when the snapshot can't be written.
# CAIRN_REQUIRE_MIGRATION_SNAPSHOT=0

# ---------- agent CLI auto-update (optional) ----------
# Off by default. When on, the enabled coaching CLIs are re-installed on a timer.
# This runs vendor installer scripts inside the container — only enable it on a
# trusted local host / tailnet, never on an internet-exposed deployment.
# AGENT_CLI_AUTO_UPDATE=0
# AGENT_CLI_AUTO_UPDATE_INTERVAL_HOURS=168

# ---------- advanced overrides (rarely needed) ----------
# AGENTS_CONFIG=             # path to an alternate agents.json
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# GEMINI_TEXT_MODEL=gemini-3.6-flash
# Exercise art only. Unset = use GEMINI_IMAGE_MODEL. Recommended: gemini-3-pro-image
# — a pro model holds the clay-figurine style across the set. Setting this is also
# the opt-in to style references: each exercise generation then rides along with up
# to 3 already-cached figurines. ART_EXERCISE_STYLE_REFS=0 opts back out.
# GEMINI_EXERCISE_IMAGE_MODEL=gemini-3-pro-image
# ART_EXERCISE_STYLE_REFS=1
# Cost vars are optional: the per-image/per-token default follows the selected model
# (nano banana 2.1 $0.0336, flash image $0.067, pro image $0.134). Set only to override.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image  # cheaper, 1K only, no search grounding
# ART_IMAGE_COST_USD=        # spend-telemetry estimate per generated image
# Per-image estimate for the exercise override model only, so a mixed-model setup
# isn't priced at one flat rate. Unset = the model's table price.
# ART_EXERCISE_IMAGE_COST_USD=
# ART_TEXT_IN_USD_PER_M=     # spend-telemetry token pricing for the canonicalize call
# ART_TEXT_OUT_USD_PER_M=
# DAYREAD_PRECOMPUTE_HOUR=   # local hour the scheduler precomputes the next day-read
